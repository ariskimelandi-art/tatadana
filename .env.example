# ==============================================================================
# TATADANA ENVIRONMENT CONFIGURATION
# Salin file ini ke .env.local dan isi nilai kredensial Anda
# ==============================================================================

# NEXT PUBLIC URL & WEBHOOK BASE URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WEBHOOK_BASE_URL="https://your-domain.ngrok-free.app"

# SUPABASE CREDENTIALS
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="tatadana-exports"

# TELEGRAM BOT CREDENTIALS
# Bot tunggal dipakai bersama seluruh user, token didapat dari @BotFather
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_BOT_USERNAME="tatadana_bot"

# AI PROVIDER API KEYS (Fallback default, juga dikelola & dienkripsi via Admin Dashboard)
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"

# MIDTRANS PAYMENT GATEWAY
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY="SB-Mid-server-your-server-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-your-client-key"
MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# APP SECURITY & ENCRYPTION KEY (32-character key for encrypting provider keys in DB)
APP_ENCRYPTION_KEY="12345678901234567890123456789012"
NEXT_PUBLIC_ADMIN_EMAIL="geninggkimteaa@gmail.com"
